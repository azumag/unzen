{
  "name": "@unzen/llm-proto",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed LLM inference pipeline: Petals-inspired checkpoint-resume architecture for browser WebGPU workers",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:workers-smoke": "vitest run tests/workers-coordinator-miniflare-smoke.test.ts",
    "test:workers-load-smoke": "vitest run tests/workers-coordinator-load-shaped-smoke.test.ts",
    "test:workers-deployed-smoke": "vitest run tests/workers-coordinator-deployed-smoke.test.ts",
    "test:workers-production-gate": "vitest run tests/workers-coordinator-production-observability-canary.test.ts",
    "test:workers-signed-runner-gate": "vitest run tests/workers-coordinator-signed-runner-release-gate.test.ts",
    "test:workers-signed-runner-browser-preview": "vitest run tests/workers-coordinator-signed-runner-browser-preview.test.ts",
    "test:workers-signed-runner-webgpu-worker-pilot": "vitest run tests/workers-coordinator-signed-runner-webgpu-worker-pilot.test.ts",
    "test:workers-webgpu-telemetry": "vitest run tests/workers-coordinator-webgpu-worker-performance-telemetry.test.ts",
    "test:workers-fleet-slo-cost": "vitest run tests/workers-coordinator-production-worker-fleet-slo-cost.test.ts",
    "test:workers-publisher-settlement": "vitest run tests/workers-coordinator-publisher-reward-settlement.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "miniflare": "^4.20260521.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
