{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unzen-llm-continuous-assurance-pager-adapter",
  "main": "./continuous-assurance-pager-adapter-worker.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "PAGER_API_URL": "https://pager-api.example.invalid/events",
    "PAGER_MAX_ATTEMPTS": "2",
    "CONFIG_FINGERPRINT_SHA256": "SET_BY_DEPLOY_PIPELINE"
  },
  "secrets": {
    "required": ["PAGER_API_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
