{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unzen-local-production-provider-canary-invoker",
  "main": "./continuous-assurance-production-provider-canary-invoker-worker.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "PROVIDER_CANARY_CONTROLLER",
      "service": "unzen-llm-continuous-assurance-production-provider-canary",
      "remote": true
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8791,
    "local_protocol": "http"
  },
  "secrets": {
    "required": ["PROVIDER_CANARY_CONTROLLER_SECRET"]
  }
}
