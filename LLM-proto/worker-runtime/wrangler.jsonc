{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unzen-llm-continuous-assurance",
  "main": "./continuous-assurance-worker.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTINUOUS_ASSURANCE_STATE",
        "class_name": "ContinuousAssuranceRuntimeState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ContinuousAssuranceRuntimeState"]
    }
  ],
  "services": [
    {
      "binding": "ASSURANCE_ENGINE",
      "service": "unzen-llm-continuous-assurance-engine"
    }
  ],
  "vars": {
    "CONTINUOUS_ASSURANCE_SCOPE": "publisher-tax-exception-archive-dr",
    "RUN_LEASE_MS": "60000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
