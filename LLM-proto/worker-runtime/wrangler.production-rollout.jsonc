{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unzen-llm-continuous-assurance-production-rollout",
  "main": "./continuous-assurance-production-rollout-worker.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    { "binding": "PROVIDER_ADAPTER", "service": "unzen-llm-continuous-assurance-provider-adapter" },
    { "binding": "EVIDENCE_ADAPTER", "service": "unzen-llm-continuous-assurance-evidence-adapter" },
    { "binding": "PAGER_ADAPTER", "service": "unzen-llm-continuous-assurance-pager-adapter" },
    { "binding": "PROVIDER_CANARY_VERIFIER", "service": "unzen-llm-continuous-assurance-production-provider-canary-verifier" },
    { "binding": "ROLLOUT_VERIFIER", "service": "unzen-llm-continuous-assurance-production-rollout-verifier" }
  ],
  "r2_buckets": [
    { "binding": "ROLLOUT_EVIDENCE_BUCKET", "bucket_name": "unzen-continuous-assurance-evidence" }
  ],
  "vars": {
    "DEPLOYMENT_VERIFIER_NAME": "unzen-independent-evidence-verifier",
    "PROVIDER_CANARY_VERIFIER_NAME": "unzen-production-provider-canary-verifier",
    "PROVIDER_CANARY_VERIFIER_VERSION": "1.0.0",
    "ROLLOUT_VERIFIER_NAME": "unzen-production-rollout-verifier",
    "ROLLOUT_VERIFIER_VERSION": "1.0.0",
    "ROLLOUT_CONTROLLER_VERSION": "1.0.0",
    "EXPECTED_DEPLOY_COMMIT_SHA": "SET_BY_DEPLOY_PIPELINE",
    "EXPECTED_DEPLOYMENT_MANIFEST_SHA256": "SET_BY_DEPLOY_PIPELINE",
    "EXPECTED_CONFIG_FINGERPRINTS_JSON": "SET_BY_DEPLOY_PIPELINE",
    "ROLLOUT_MIN_PROVIDER_AVAILABILITY_PCT": "99",
    "ROLLOUT_ALLOWED_FAILURE_BUDGET": "3",
    "ROLLOUT_CYCLE_CADENCE_MS": "300000",
    "ROLLOUT_ROTATION_CADENCE_MS": "2592000000",
    "ROLLOUT_DR_CADENCE_MS": "2592000000",
    "ROLLOUT_RETENTION_MS": "2592000000",
    "ROLLOUT_ONCALL_ROUTE": "SET_BY_DEPLOY_PIPELINE",
    "ROLLOUT_ESCALATION_TARGET": "SET_BY_DEPLOY_PIPELINE"
  },
  "secrets": {
    "required": ["ROLLOUT_CONTROLLER_SECRET"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
