{
  "name": "unzen",
  "version": "0.1.0",
  "private": true,
  "description": "unzen core: Browser-delegated function execution framework (self-consumption model)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "npm run build -w @unzen/shared && npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @unzen/shared && tsc -p packages/client/tsconfig.test.json --noEmit",
    "clean": "rm -rf packages/*/dist demo/dist"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "hono": "^4.12.22"
  },
  "overrides": {
    "rollup": "^4.60.4"
  }
}
