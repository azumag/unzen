{
  "name": "@unzen/client",
  "version": "0.1.0",
  "description": "Browser client SDK for unzen core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@unzen/shared": "file:../shared",
    "quickjs-emscripten-core": "^0.31.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.31.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
