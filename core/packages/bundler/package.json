{
  "name": "@unzen/bundler",
  "version": "0.1.0",
  "description": "Module bundler for unzen core sandbox functions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webpack-loader": {
      "types": "./dist/webpack-loader.d.ts",
      "import": "./dist/webpack-loader.js",
      "require": "./dist/webpack-loader.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "magic-string": "^0.30.21",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@unzen/shared": "file:../shared",
    "tsup": "^8.5.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.7"
  }
}
