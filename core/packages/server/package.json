{
  "name": "@unzen/server",
  "version": "0.1.0",
  "description": "Server-side framework for unzen core (Hono-based)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@unzen/shared": "0.1.0",
    "hono": "^4.12.22",
    "quickjs-emscripten": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  }
}
