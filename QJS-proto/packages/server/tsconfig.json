{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Package-relative path resolution
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Path aliases for workspace references
    "paths": {
      "@unzen/shared": ["../shared/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "tests"],
  "references": [
    { "path": "../shared" }
  ]
}
